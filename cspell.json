{
    "import": ["@cspell/dict-lorem-ipsum/cspell-ext.json", "@cspell/dict-css"],
    "language": "en",
    "caseSensitive": false,
    "dictionaries": ["custom-dictionary"],
    "dictionaryDefinitions": [
        {
            "name": "custom-dictionary",
            "path": "./.cspell/custom-dictionary.txt",
            "addWords": true
        }
    ],
    "ignorePaths": [
        "**/node_modules/**",
        "**/dict/**",
        "**/dist/**",
        "**/build/**",
        "**/lib/**",
        "**/cache/**",
        "**/pnpm-lock.yaml"
    ]
}
