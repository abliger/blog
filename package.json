{
    "name": "blog",
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.20.0",
        "npm": ">=10.9.2",
        "pnpm": ">=10.19.0"
    },
    "scripts": {
        "test": "vitest run --coverage",
        "db": "json-server .vitepress/db/db.json",
        "prettier": "prettier --write .",
        "lint:eslint": "NODE_ENV=development eslint . --fix",
        "lint:spellcheck": "cspell lint \"(packages|.vitepress)/**/*.{js,ts,mjs,cjs,json,css,less,sass,vue,html,md}\"",
        "commit": "git-cz",
        "precommit": "pnpm test && pnpm prettier && pnpm lint:eslint && pnpm lint:spellcheck && git add .",
        "prepare": "husky",
        "docs:dev": "vitepress dev --host",
        "docs:build": "vitepress build",
        "docs:preview": "vitepress preview",
        "postinstall": "pnpm --filter style-vue build"
    },
    "config": {
        "commitizen": {
            "path": "node_modules/cz-git"
        }
    },
    "dependencies": {
        "gsap": "^3.13.0",
        "json-server": "1.0.0-beta.3",
        "lil-gui": "^0.21.0",
        "normalize-wheel": "^1.0.1",
        "splitting": "^1.1.0",
        "style-vue": "workspace:*",
        "three": "^0.181.1",
        "vite": "^7.1.12",
        "vitepress": "2.0.0-alpha.12",
        "vue": "^3.5.22"
    },
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@cspell/dict-css": "^4.0.18",
        "@cspell/dict-lorem-ipsum": "^4.0.5",
        "@eslint/js": "^9.38.0",
        "@nolebase/markdown-it-bi-directional-links": "^2.18.2",
        "@nolebase/markdown-it-unlazy-img": "^2.18.2",
        "@nolebase/vitepress-plugin-git-changelog": "^2.18.2",
        "@nolebase/vitepress-plugin-highlight-targeted-heading": "^2.18.2",
        "@nolebase/vitepress-plugin-thumbnail-hash": "^2.18.2",
        "@shikijs/types": "3.14.0",
        "@shikijs/vitepress-twoslash": "^3.14.0",
        "@types/node": "^24.9.2",
        "@typescript-eslint/parser": "^8.46.2",
        "@vitejs/plugin-vue-jsx": "^5.1.1",
        "@vitepress-code-preview/container": "^1.0.8",
        "@vitepress-code-preview/plugin": "^1.0.6",
        "@vitest/coverage-v8": "4.0.5",
        "commitizen": "^4.3.1",
        "cspell": "^9.2.2",
        "cz-git": "^1.12.0",
        "eslint": "^9.38.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^10.5.1",
        "globals": "^16.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.6",
        "markdown-it-mathjax3": "^4.3.2",
        "prettier": "^3.6.2",
        "rollup-plugin-visualizer": "^6.0.5",
        "typescript-eslint": "^8.46.2",
        "vite-plugin-glsl": "^1.5.4",
        "vite-plugin-vue-devtools": "^8.0.3",
        "vite-plugin-vue-inspector": "^5.3.2",
        "vitepress-mermaid-renderer": "^1.0.15",
        "vitepress-plugin-comment-with-giscus": "^1.1.15",
        "vitepress-plugin-rss": "^0.3.2",
        "vitest": "^4.0.5",
        "vue-eslint-parser": "^10.2.0"
    },
    "lint-staged": {
        "*.{vue,js,ts,jsx,tsx,md,json}": [
            "eslint --fix --concurrency=auto",
            "prettier --write --experimental-cli"
        ]
    }
}
